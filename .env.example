# Optional: enables Gemini-assisted text features. Core mail features work without it.
GEMINI_API_KEY=

# Optional: sends Bug Report and Feature Request forms by SMTP.
# Without this configuration, reports remain in the local feedback outbox.
FEEDBACK_SMTP_HOST=
FEEDBACK_SMTP_PORT=465
FEEDBACK_SMTP_USER=
FEEDBACK_SMTP_PASS=
FEEDBACK_FROM=
FEEDBACK_TO=
